# Copy to .env (`make env`) and fill in. .env is gitignored. Never commit secrets.
# Every variable is read by pydantic-settings; missing required values fail fast at startup.

# ---------------------------------------------------------------- Mock gateway (Phase 1)
# Bearer token the MOCK gateway accepts (min 16 chars). `make env` generates it.
# Generate one manually with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MOCK_GATEWAY_TOKEN=change-me-to-a-long-random-value
MOCK_HOST=127.0.0.1
MOCK_PORT=8081
MOCK_DB_PATH=.data/mock_backend.sqlite3
MOCK_DRAFT_TTL_SECONDS=900
# Chaos defaults at startup (change at runtime: POST /_admin/chaos, docs/development.md)
MOCK_CHAOS_DELAY_MS=0
MOCK_CHAOS_FAIL_RATE=0.0
MOCK_CHAOS_FAIL_STATUS=503
MOCK_ADMIN_ENABLED=true

# ---------------------------------------------------------------- Gateway client (MCP server side)
# How the MCP server reaches the domain APIs: {GATEWAY_BASE_URL}{endpoint path}.
# One gateway host per environment.
GATEWAY_BASE_URL=http://127.0.0.1:8081
# The MCP server's OWN service token (Option A). Never the end user's token.
# In this lab it must equal MOCK_GATEWAY_TOKEN; `make env` sets both.
GATEWAY_TOKEN=change-me-to-a-long-random-value
# Safety interlock: non-localhost gateways are refused unless this is true
# (and then https is mandatory). Keep false: this lab uses synthetic data only.
GATEWAY_ALLOW_NON_LOCAL=false
# Endpoint catalogue (docs/operations.md, server/src/telco_mcp/endpoints.py). Leave UNSET locally:
# the defaults are the mock's paths. Set per environment; production requires all six.
# Paths only (host = GATEWAY_BASE_URL); use exactly the {placeholders} shown.
# GATEWAY_ENDPOINT_GET_ACCOUNT=/boaccount/API/account/{account_id}
# GATEWAY_ENDPOINT_LIST_SUBSCRIPTIONS=/bosubscription/API/subscription?account_id={account_id}&status={status}&limit={limit}&cursor={cursor}
# GATEWAY_ENDPOINT_GET_SUBSCRIPTION=/bosubscription/API/subscription/{subscription_id}
# GATEWAY_ENDPOINT_GET_SERVICE=/boservice/API/service/{service_id}
# GATEWAY_ENDPOINT_GET_ORDER=/boorder/API/order/{order_id}
# GATEWAY_ENDPOINT_LIST_ORDERS=/boorder/API/order?account_id={account_id}&limit={limit}&cursor={cursor}

# ---------------------------------------------------------------- MCP server (Phase 2+)
# stdio has no headers (no token): the process runs with these scopes, space-separated.
# read = the read tools, PII masked. Add pii:read to see full names/numbers (synthetic).
MCP_STDIO_SCOPES=read
MCP_HOST=127.0.0.1
MCP_PORT=8090
MCP_PUBLIC_URL=http://127.0.0.1:8090/mcp
# Logging (docs/operations.md). json = ECS lines for ELK (the image default; required in production).
MCP_LOG_FORMAT=text
MCP_LOG_LEVEL=INFO
# Seconds to drain in-flight requests on SIGTERM (rolling deploys).
MCP_SHUTDOWN_GRACE_S=20
# OpenTelemetry (standard variables; unset = no export). Traces + logs over OTLP/HTTP:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_LOGS_EXPORTER=none            # keep logs on stdout only
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# local | dev | test | production. production refuses lab/lower-env settings (startup guard G2, docs/architecture-security.md).
MCP_ENVIRONMENT=local

# ---------------------------------------------------------------- HTTP auth: always JWT (docs/architecture-security.md)
# Which client_ids may call, and their max scopes (non-secret).
MCP_CLIENTS_CONFIG=server/config/clients.json
# Host headers accepted when deployed (JSON list), e.g. ["mcp.internal.example:*"]
# MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
# Leave all MCP_JWT_* empty locally: `make mcp-http` then trusts the dev keys (make dev-keys).
# For a real token service, confirm EVERY value against a decoded (non-production) token.
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
# Exactly one key source: the token service's JWKS endpoint (https) or a local JWKS file.
MCP_JWT_JWKS_URL=
MCP_JWT_JWKS_FILE=
# MCP_JWT_ALGORITHMS=["RS256"]
# MCP_JWT_CLIENT_ID_CLAIMS=["client_id","azp"]
# MCP_JWT_SCOPE_CLAIM=scope
# MCP_JWT_REQUIRED_CLAIMS=["exp","iat","iss","aud"]
# MCP_JWT_MAX_LIFETIME_S=7200
# MCP_JWT_LEEWAY_S=30
# JWKS fetch through the corporate proxy / custom CA (off by default):
# MCP_JWT_JWKS_TRUST_ENV=false
# MCP_JWT_JWKS_CA_BUNDLE=

# ---------------------------------------------------------------- Model check (lab: make model-check)
# Gemini Developer API key (aistudio.google.com). The standard GEMINI_API_KEY also works;
# CHAT_GEMINI_API_KEY wins. Base URL and API mode are pinned in code (docs/development.md).
CHAT_GEMINI_API_KEY=
CHAT_GEMINI_MODEL=gemini-flash-latest   # pin a model ID your company allows
# CHAT_GEMINI_PROXY=
# CHAT_GEMINI_CA_BUNDLE=
# stdio (default): the harness starts the MCP server itself (scopes: MCP_STDIO_SCOPES).
# http: call a running `make mcp-http` with HARNESS_BEARER_TOKEN (paste from `make token`).
HARNESS_TRANSPORT=stdio
HARNESS_MCP_URL=http://127.0.0.1:8090/mcp
HARNESS_BEARER_TOKEN=
HARNESS_PROTOCOL=auto
HARNESS_MAX_STEPS=8
HARNESS_SYSTEM_PROMPT_FILE=lab/prompts/agent.system.md
HARNESS_USE_SERVER_INSTRUCTIONS=true
HARNESS_GUARDRAILS_FILE=lab/config/guardrails.json

# ---------------------------------------------------------------- Dev token service (LOCAL ONLY)
# Stand-in for the lower-env token service (docs/development.md, connector). `make env`
# generates the secret. It never leaves your laptop and is only valid against the dev keys.
DEV_TOKEN_SERVICE_CLIENT_ID=lowerenv-shared
DEV_TOKEN_SERVICE_CLIENT_SECRET=
DEV_TOKEN_SERVICE_SCOPES=read
