# Copy to .env (`make env`) and fill in. .env is gitignored. Never commit secrets.
# Every variable is read by pydantic-settings; missing required values fail fast at startup.

# ---------------------------------------------------------------- Mock gateway (Phase 1)
# Bearer token the MOCK gateway accepts (min 16 chars). `make env` generates it.
# Generate one manually with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MOCK_GATEWAY_TOKEN=change-me-to-a-long-random-value
MOCK_HOST=127.0.0.1
MOCK_PORT=8081
MOCK_DB_PATH=.data/mock_backend.sqlite3
MOCK_DRAFT_TTL_SECONDS=900
# Chaos defaults at startup (can be changed at runtime with make chaos-*)
MOCK_CHAOS_DELAY_MS=0
MOCK_CHAOS_FAIL_RATE=0.0
MOCK_CHAOS_FAIL_STATUS=503
MOCK_ADMIN_ENABLED=true

# ---------------------------------------------------------------- Gateway client (MCP server side)
# How the MCP server reaches the domain APIs:
#   {GATEWAY_BASE_URL}/{GATEWAY_SVC_*}/{GATEWAY_API_SEGMENT}/{resource}
#   e.g. http://127.0.0.1:8081/bosubscription/API/subscription/
GATEWAY_BASE_URL=http://127.0.0.1:8081
# The MCP server's OWN service token (Option A). Never the end user's token.
# In this lab it must equal MOCK_GATEWAY_TOKEN; `make env` sets both.
GATEWAY_TOKEN=change-me-to-a-long-random-value
# Safety interlock: non-localhost gateways are refused unless this is true
# (and then https is mandatory). Keep false: this lab uses synthetic data only.
GATEWAY_ALLOW_NON_LOCAL=false
# Path layout. Microservice names are PLACEHOLDERS; rename to match your org.
# Read by BOTH the mock gateway (to mount routes) and the MCP client (to call them).
GATEWAY_API_SEGMENT=API
GATEWAY_SVC_ACCOUNT=boaccount
GATEWAY_SVC_SUBSCRIPTION=bosubscription
GATEWAY_SVC_SERVICE=boservice
GATEWAY_SVC_ORDER=boorder
GATEWAY_SVC_ORDER_SUBMISSION=boordersubmission

# ---------------------------------------------------------------- MCP server (Phase 2+)
# Who may call the MCP server. Tenants/scopes per caller are in config/access.json
# (non-secret); the bearer tokens are secrets and live ONLY here. `make env` generates them.
# A caller whose token is empty cannot log in. Min 24 chars. Each must be unique.
MCP_TOKEN_ALICE=
MCP_TOKEN_BOB=
MCP_TOKEN_CAROL=
MCP_TOKEN_MALLORY=
# stdio has no headers: the process runs as this caller.
MCP_STDIO_CALLER=alice
MCP_ACCESS_CONFIG=config/access.json
MCP_HOST=127.0.0.1
MCP_PORT=8090
MCP_PUBLIC_URL=http://127.0.0.1:8090/mcp
# LAB DEMO ONLY: send free-text notes to the model verbatim (see the injection demo).
MCP_UNSAFE_RAW_FREE_TEXT=false

# ---------------------------------------------------------------- Azure OpenAI (Phase 5)
# v1 endpoint (no api-version): https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Your DEPLOYMENT name (it's sent as `model`), e.g. a gpt-5 or gpt-4.1 deployment.
AZURE_OPENAI_DEPLOYMENT=
# bearer = "Authorization: Bearer <key>" (default); api-key = "api-key: <key>" header.
AZURE_OPENAI_AUTH_HEADER=bearer
# Corporate proxy: the standard HTTPS_PROXY / SSL_CERT_FILE variables are honoured
# automatically. Or set them explicitly here (credentials may go in the proxy URL):
# AZURE_OPENAI_PROXY=http://user:pass@proxy.corp.example:8080
# AZURE_OPENAI_CA_BUNDLE=/path/to/corporate-root-ca.pem
AZURE_OPENAI_TIMEOUT_S=60
AZURE_OPENAI_MAX_RETRIES=2
# Optional sampling knobs. Leave unset for GPT-5-family (reasoning) deployments,
# which reject `temperature`. Set only what your model supports.
# AZURE_OPENAI_TEMPERATURE=0
# AZURE_OPENAI_MAX_COMPLETION_TOKENS=1024
# AZURE_OPENAI_REASONING_EFFORT=low

# ---------------------------------------------------------------- Harness (Phase 5)
HARNESS_MCP_URL=http://127.0.0.1:8090/mcp
# Which MCP identity the harness uses (token from MCP_TOKEN_<CALLER> above).
HARNESS_CALLER=alice
HARNESS_PROTOCOL=auto
HARNESS_MAX_STEPS=8
# Ask y/N before any tool not annotated read-only. Keep true.
HARNESS_CONFIRM_DESTRUCTIVE=true
# Prompt layers and host guardrails (see docs/05b):
HARNESS_SYSTEM_PROMPT_FILE=prompts/agent.system.md
HARNESS_USE_SERVER_INSTRUCTIONS=true
HARNESS_GUARDRAILS_FILE=config/guardrails.json
