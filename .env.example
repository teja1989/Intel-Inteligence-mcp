# Copy to .env (`make env`) and fill in. .env is gitignored. Never commit secrets.
# Every variable is read by pydantic-settings; missing required values fail fast at startup.

# ---------------------------------------------------------------- Mock backend (Phase 1)
# Service-to-service key the MCP server uses to call the mock APIs (min 16 chars).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MOCK_API_KEY=change-me-to-a-long-random-value
MOCK_HOST=127.0.0.1
MOCK_PORT=8081
MOCK_DB_PATH=.data/mock_backend.sqlite3
MOCK_DRAFT_TTL_SECONDS=900
# Chaos defaults at startup (can be changed at runtime with make chaos-*)
MOCK_CHAOS_DELAY_MS=0
MOCK_CHAOS_FAIL_RATE=0.0
MOCK_CHAOS_FAIL_STATUS=503
MOCK_ADMIN_ENABLED=true

# ---------------------------------------------------------------- MCP server (Phase 2+)
# Added in later phases (bearer tokens -> tenant/scopes, backend URL, timeouts).

# ---------------------------------------------------------------- Azure OpenAI (Phase 5)
# Added in Phase 5, after confirming how you reach Azure OpenAI (see README "Open questions").
